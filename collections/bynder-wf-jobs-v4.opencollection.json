{
  "opencollection": "1.0.0",
  "info": {
    "name": "Workflow Jobs API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Presets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve specific job preset",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{your-bynder-domain}/api/workflow/presets/job/:id",
            "params": [
              {
                "name": "id",
                "value": "00000000-0000-0000-0000-000000000000",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve specific job preset"
        }
      ]
    },
    {
