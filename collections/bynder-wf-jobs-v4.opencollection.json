        "name": "Jobs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve jobs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{your-bynder-domain}/api/workflow/jobs",
            "params": [
              {
                "name": "dateCreatedFrom",
                "value": "2020-01-01T12:00:00Z",
                "type": "query"
              },
              {
                "name": "dateCreatedTo",
                "value": "2020-01-01T12:00:00Z",
                "type": "query"
              },
              {
                "name": "dateModifiedFrom",
                "value": "2020-01-01T12:00:00Z",
                "type": "query"
              },
              {
                "name": "dateModifiedTo",
                "value": "2020-01-01T12:00:00Z",
                "type": "query"
              },
              {
                "name": "deadlineFrom",
                "value": "2020-01-01T12:00:00Z",
                "type": "query"
              },
              {
                "name": "deadlineTo",
                "value": "2020-01-01T12:00:00Z",
                "type": "query"
              },
              {
                "name": "resonsibleIDs",
                "value": "00000000000000000000000000000000,00000000000000000000000000000000",
                "type": "query"
              },
              {
                "name": "accountableIDs",
                "value": "00000000000000000000000000000000,00000000000000000000000000000000",
                "type": "query"
              },
              {
                "name": "status",
                "value": "Approved,NeedsChanges",
                "type": "query"
              },
              {
                "name": "orderBy",
                "value": "deadline asc",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "100",
                "type": "query"
              },
              {
                "name": "page",
                "value": "1",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve jobs"
        },
        {
          "info": {
            "name": "Create job",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{your-bynder-domain}/api/workflow/jobs",
            "body": {
              "type": "json",
              "data": "{}"
