      "name": "Scopes endpoint",
      "description": {
        "content": "The scopes endpoint provides a JSON formatted overview of the existing scopes within Bynder\nand what user permissions are required in order for the OAuth2 service to grant a scope to a user.\n",
        "type": "text/plain"
      },
      "item": [],
      "event": []
