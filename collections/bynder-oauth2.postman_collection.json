  "item": [
    {
      "id": "818a05cd-517e-48f9-8557-643e39130e19",
      "name": "Authorize endpoint",
      "description": {
        "content": "When using the Authorization Code grant, redirect the user to the [Authorize application](#reference/oauth-2.0/authorize-endpoint/authorize-application) endpoint. After the user\nis authenticated and approves the authorization request, Bynder will redirect the user back with an\nauthorization code which can then be passed to the [Token endpoint](#reference/oauth-2.0/token-endpoint/using-an-authorization-code).\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "5480bdcd-406e-4fed-aac2-21ab0dbf3b49",
