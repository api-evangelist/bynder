    {
      "id": "e7c92eaf-7433-4eaa-83d9-f4073a8df914",
      "name": "Token endpoint",
      "description": {
        "content": "Use the token endpoint to retrieve a access token which can be used to authorize API\nrequests. Depending on the type of grant, different fields are required which are\noutlined per request.\n\n_The token endpoint requires authorization either in the body or by\nsending the Authorization header._\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "ac52acfc-433e-4821-95e3-b390beea670f",
          "name": "Using an authorization code or the refresh token",
          "request": {
            "name": "Using an authorization code or the refresh token",
            "description": {
              "content": "Use the token endpoint to retrieve an access token which can be used to authorize API\nrequests. This endpoint supports the Authorization Code grant, the Refresh Token grant and the Client Credentials grant.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v6",
                "authentication",
                "oauth2",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "Application client ID."
                },
                {
                  "disabled": false,
                  "key": "client_secret",
                  "value": "<string>",
                  "description": "Application client secret."
                },
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "Identifies the grant type being used. For Authorization Code grant use **authorization_code**."
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<string>",
                  "description": "The URL specified in the Authorize application request, the values must match."
                },
                {
                  "disabled": false,
                  "key": "code",
                  "value": "<string>",
                  "description": "The Authorization Code returned from the Authorize application request."
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "List of scopes to request to be granted to the access token. Can only be a subset of the scopes requested in the Authorize application request. When not passed, all the scopes will be requested."
                },
                {
                  "disabled": false,
                  "key": "refresh_token",
                  "value": "<string>",
                  "description": "Refresh token returned from the Retrieve token request."
                }
              ]
            }
          },
