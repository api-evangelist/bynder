    {
      "id": "871c31bc-e75d-4a8b-a416-a993d5fea288",
      "name": "Asset Usage",
      "description": {
        "content": "These calls allow you to keep track of assets being exported from Bynder and imported into a third party application. In order to get started or find an existing integration id you should check out this Bynder support article. If you want to register a new third party application please contact us at [support@bynder.com](mailto:support@bynder.com).\n\n__Warning:__ Requires the STATISTICS security role.\n",
        "type": "text/plain"
      },
