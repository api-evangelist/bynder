    {
      "id": "e0a9df13-f055-42e8-b638-ec6a239326c1",
      "name": "Asset Usage Sync",
      "description": {
        "content": "This alternative API call allows you to sync all your usage from a single integration.\n* A usage will be created when there is no existing usage on the specified asset\n* A usage will be updated when adding additional info\n* A usage will be deleted when specifying a URI but not using that URI in a usage\n\n__Warning:__ Requires the STATISTICS security role.\n",
        "type": "text/plain"
      },
