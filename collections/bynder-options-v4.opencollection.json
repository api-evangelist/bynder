              },
              {
                "name": "optionId",
                "value": "",
                "type": "path",
                "description": "The id of the (metaproperty) option the dependency group belongs to."
              },
              {
                "name": "groupId",
                "value": "",
                "type": "path",
                "description": "The id of the dependency group you’d like to remove a dependency from."
              },
              {
                "name": "dependencyId",
                "value": "",
