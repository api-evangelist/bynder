{
  "opencollection": "1.0.0",
  "info": {
    "name": "Trash API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Trash",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve recently removed assets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{your-bynder-domain}/api/trash/media",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "dateRemoved",
                "value": "",
                "type": "query"
              },
              {
                "name": "field",
                "value": "",
                "type": "query"
              },
              {
                "name": "order",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://{your-bynder-domain}/v6/authentication/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve assets removed in the last 30 days."
        }
      ]
    }
  ],
  "bundled": true
}