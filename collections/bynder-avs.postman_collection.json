          "name": "Get public links for an asset",
          "request": {
            "name": "Get public links for an asset",
            "description": {
              "content": "This API returns public links to both HLS and DASH manifests for video assets, as well as the Video player HTML embed code to integrate Adaptive Video Streaming links with a supported video player. This endpoint uses the newer, standard UUID format of 8-4-4-4-12, and letters are lowercase. See the example for `asset_id`, and [Note on identifiers](https://api.bynder.com/docs/getting-started#note-on-identifiers) for more information.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "1",
                "assets",
                ":asset_id",
                "public-links"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "asset_id",
                  "description": "(Required) The UUID of the asset"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
