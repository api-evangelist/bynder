{
  "opencollection": "1.0.0",
  "info": {
    "name": "Groups",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve groups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{your-bynder-domain}/api/groups/list/",
            "params": [
              {
                "name": "search_term",
                "value": "",
                "type": "query",
                "description": "Search on matching group names."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "What page of results to return."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum results to return. If limit is not provided the first 20 results will be returned."
              },
              {
                "name": "sort_order",
                "value": "",
                "type": "query",
                "description": "Order of the returned list of groups."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Requires the **GROUPMANAGEMENT** security role."
        }
      ]
    }
  ],
  "bundled": true
}