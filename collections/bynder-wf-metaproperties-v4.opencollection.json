{
  "opencollection": "1.0.0",
  "info": {
    "name": "Workflow Metaproperties API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Metaproperties",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve metaproperties",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{your-bynder-domain}/api/workflow/metaproperties",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve metaproperties"
        },
        {
          "info": {
            "name": "Retrieve specific metaproperty",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{your-bynder-domain}/api/workflow/metaproperties/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve specific metaproperty"
        }
      ]
    }
  ],
  "bundled": true
}